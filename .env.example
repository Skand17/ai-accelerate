# ── Contact form backend ─────────────────────────────────────────────
# Default: Formspree form "maewllyl" (hardcoded in src/lib/contact.ts).
# Submissions POST as JSON to https://formspree.io/f/maewllyl and are
# delivered to the inbox configured in the Formspree dashboard.

# Use a different Formspree form (e.g. a test form for staging):
# VITE_FORMSPREE_ID=yourFormId

# Or bypass Formspree entirely with any endpoint accepting a JSON POST
# (own API, Make/Zapier webhook, etc.):
# VITE_CONTACT_ENDPOINT=https://your-endpoint.example.com/lead
